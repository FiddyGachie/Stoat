# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ───────────────────────────────────────────────────────────────────
# Supabase (production / staging) — Transaction Pooler connection string.
# Copy from Supabase dashboard → Settings → Database → Connection string → URI (Transaction pooler)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Direct connection (use port 5432 for migrations / Drizzle Studio):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
#
# Local Postgres:
DATABASE_URL=postgresql://stoat:stoatpassword@localhost:5432/stoat
#
# Leave blank (or unset) to fall back to embedded PGlite for local demos.

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=stoat-jwt-secret-key-32-chars-minimum!

# ── PayPal Sandbox ─────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:3000/v1/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/v1/paypal/cancel
# PayPal is always the real API (Sandbox host above). There is no simulated mode.
# Where PayPal sends the buyer back to the console after approving/cancelling:
CONSOLE_URL=http://localhost:5173
# true = providers cannot deliver until the buyer has paid through PayPal. Keep true in production.
REQUIRE_FUNDING=false

# ── LLM Provider ──────────────────────────────────────────────────────────────
# LLM_PROVIDER selects the active provider:
#   fireworks  — Fireworks AI serverless (default, OpenAI-compatible)
#   anthropic  — Anthropic Messages API (legacy)
LLM_PROVIDER=fireworks

# ── Fireworks AI (primary — serverless, pay-per-token) ─────────────────────────
# Get your key at https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=

# Model ID format for Fireworks serverless: accounts/fireworks/models/<name>
# Recommended fast/cheap agent model:
LLM_MODEL_AGENT=accounts/fireworks/models/gpt-oss-120b

# ── Anthropic (alternative — set LLM_PROVIDER=anthropic to use) ───────────────
LLM_API_KEY=
# LLM_MODEL_AGENT=claude-3-5-sonnet-20241022

# ── LLM mode ──────────────────────────────────────────────────────────────────
# live    — call the configured provider in real-time
# record  — call live and save request hash → response to DB
# replay  — serve previously recorded responses (deterministic, no API cost)
# record = live model call whose answer is stored; replay = only stored answers (fails on new prompts); live = no storage.
LLM_MODE=record

# ── Agent runtime limits ───────────────────────────────────────────────────────
AGENT_MAX_STEPS=12
AGENT_MAX_SECONDS=90
AGENT_MAX_COST_USD=0.25

# ── Demo / observability ───────────────────────────────────────────────────────

# -- Auth tuning (all optional; defaults shown) --
# USER_TOKEN_TTL_SECONDS=28800        # human session: 8h
# AGENT_TOKEN_TTL_SECONDS=900         # agent token: 15m
# LOGIN_MAX_FAILURES_PER_ACCOUNT=5    # then 429 for 15 min
# LOGIN_MAX_FAILURES_PER_IP=100
# SIGNUP_MAX_PER_IP_PER_HOUR=20
# MAX_AGENTS_PER_TENANT=50
# TRUST_PROXY_HOPS=1                  # set automatically on Render/Vercel

# ── v2.1 PayPal governance ─────────────────────────────────────────────────────
# PayPal is the only payment rail. Any other value stops the server at startup.
PAYMENT_PROVIDER=PAYPAL
# Provider payouts stay off until `
pm run paypal:spike` passes for your PayPal app.
PAYPAL_PAYOUTS_ENABLED=false
PAYPAL_PAYOUTS_CAPABILITY_STATUS=unknown
# Encrypts provider PayPal recipients at rest. At least 32 random characters. Required in production. Keep it stable.
RECIPIENT_ENCRYPTION_KEY=

# ── Mission Budget Wallet (all optional; defaults shown) ───────────────────────
# Funding mode for NEW tenants: direct (per-agreement funding) or wallet. Existing tenants stay direct
# until an operator or supervisor switches them with PUT /v1/admin/funding-mode.
# DEFAULT_FUNDING_MODE=direct
# Switch an existing tenant (moves approved spending budgets into the wallet):
#   npx tsx scripts/wallet/enable-wallet-mode.ts          (dry run)
#   npx tsx scripts/wallet/enable-wallet-mode.ts --apply
# WALLET_CURRENCIES=USD
# WALLET_MAX_DEPOSIT=10000.00
# WALLET_LOW_BALANCE_PCT=20
# PAYPAL_TIMEOUT_MS=30000
# PAYPAL_REFUND_WINDOW_DAYS=180
# WALLET_DEPOSIT_TTL_MS=10800000
# WALLET_SWEEP_REFUND_MS=900000
# WALLET_RECONCILE_INTERVAL_MS=86400000
# Optional email provider for wallet notifications (in-app notifications always work).
# EMAIL_API_URL=
# EMAIL_API_KEY=
# Wallet verifiers: `npm run verify:wallet` (journey, accounting, isolation) runs offline on embedded PGlite.
# `npm run verify:wallet-reconciliation` needs PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET and a Sandbox PAYPAL_BASE_URL.
# It is NOT part of `npm run verify`, refuses to run against Live, and reports order approval as MANUAL.

# ── Agentic Commerce (tenant feature flags default to off) ───────────────────
# MANDATE_MAX_LIFETIME_DAYS=30
# WATCHDOG_INTERVAL_MS=300000
# HOLD_RATE_LIMIT=20
# PROPOSAL_TTL_HOURS=24
# PROPOSAL_RATE_LIMIT=30
# PROPOSAL_MAX_BYTES=65536
# ANALYTICS_TIMEOUT_MS=10000
# INTENT_ROW_LIMIT=1000
# NL_QUESTION_RATE_LIMIT=20
# AGENT_TOOL_RATE_LIMIT=120
# AGENTIC_DAILY_MODEL_BUDGET_USD=2.00
# HELD_ACCRUAL_MAX_DAYS=14
