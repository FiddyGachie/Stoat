{
  "name": "stoat",
  "version": "2.1.0",
  "description": "Verified-delivery payments layer for autonomous software agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.cjs",
    "start": "node dist/src/index.js",
    "start:dev": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "worker": "node dist/src/worker.js",
    "worker:dev": "tsx src/worker.ts",
    "migrate": "node dist/src/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "test": "vitest run",
    "test:watch": "vitest",
    "evidence": "tsx scripts/generate-evidence.ts",
    "demo": "tsx scripts/run-demo.ts",
    "console": "vite --config console/vite.config.ts",
    "console:build": "npm run docs:build && vite build --config console/vite.config.ts",
    "start:local": "pwsh scripts/start.ps1",
    "verify:auth": "tsx scripts/verify/auth.ts",
    "verify:platform": "tsx scripts/verify/platform.ts",
    "verify": "npm run verify:auth && npm run verify:platform && npm run verify:ui",
    "console:typecheck": "tsc -p console/tsconfig.json",
    "check": "tsc --noEmit && tsc -p console/tsconfig.json && vitest run && npm run verify",
    "docs:build": "tsx scripts/build-docs.ts",
    "verify:ui": "tsx scripts/verify/ui.ts",
    "verify:wallet-journey": "tsx scripts/verify/wallet-journey.ts",
    "verify:wallet-accounting": "tsx scripts/verify/wallet-accounting.ts",
    "verify:wallet-isolation": "tsx scripts/verify/wallet-isolation.ts",
    "verify:wallet-reconciliation": "tsx scripts/verify/wallet-reconciliation.ts",
    "verify:wallet": "npm run verify:wallet-journey && npm run verify:wallet-accounting && npm run verify:wallet-isolation",
    "verify:agentic-boundary": "tsx scripts/verify/agentic-boundary.ts",
    "verify:agentic-concurrency": "tsx scripts/verify/agentic-concurrency.ts",
    "verify:agentic-injection": "tsx scripts/verify/agentic-injection.ts",
    "verify:agentic-secrets": "tsx scripts/verify/agentic-secrets.ts",
    "verify:agentic-invariants": "tsx scripts/verify/agentic-invariants.ts",
    "verify:agentic": "npm run verify:agentic-boundary && npm run verify:agentic-concurrency && npm run verify:agentic-injection && npm run verify:agentic-secrets && npm run verify:agentic-invariants",
    "admin:create": "tsx scripts/create-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "paypal:webhook": "tsx scripts/register-webhook.ts",
    "payments:watch": "tsx scripts/payments-watch.ts",
    "paypal:spike": "tsx scripts/paypal-payouts-spike.ts",
    "mcp:stdio": "tsx src/mcp/cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@paypal/paypal-server-sdk": "2.5.0",
    "ag-charts-community": "^14.2.0",
    "ag-charts-react": "^14.2.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.66.0",
    "pg": "^8.13.3",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "fast-check": "4.10.2",
    "playwright": "^1.65.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^8.3.5",
    "vitest": "^3.0.7",
    "yaml": "2.8.1"
  }
}
