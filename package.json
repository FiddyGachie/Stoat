{
  "name": "stoat",
  "version": "2.0.0",
  "description": "Verified-delivery payments layer for autonomous software agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "start:dev": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "worker": "node dist/src/worker.js",
    "worker:dev": "tsx src/worker.ts",
    "migrate": "node dist/src/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "evidence": "tsx scripts/generate-evidence.ts",
    "demo": "tsx scripts/run-demo.ts",
    "console": "vite --config console/vite.config.ts",
    "console:build": "vite build --config console/vite.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "ag-charts-community": "^14.2.0",
    "ag-charts-react": "^14.2.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.66.0",
    "pg": "^8.13.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^8.3.5",
    "vitest": "^3.0.7"
  }
}
